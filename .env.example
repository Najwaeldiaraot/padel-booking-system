# ==============================================================================
# RALLY PADEL CLUB - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env: cp .env.example .env
# Isi seluruh nilai di bawah ini sesuai akun layanan cloud masing-masing.
# Panduan lengkap pembuatan akun & kredensial: docs/SETUP_GUIDE.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE: SUPABASE POSTGRESQL (VIA PRISMA ORM)
# ------------------------------------------------------------------------------
# Dapatkan di: Supabase Console -> Project Settings -> Database -> Connection string
# Gunakan mode 'Transaction' (port 6543 + pgbouncer=true) untuk DATABASE_URL
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Gunakan mode 'Session' / 'Direct' (port 5432) untuk DIRECT_URL (diperlukan Prisma untuk migrasi)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. CACHE & LOCKING: UPSTASH REDIS SERVERLESS
# ------------------------------------------------------------------------------
# Dapatkan di: Upstash Console (https://console.upstash.com) -> Redis Database -> REST API
# Digunakan untuk atomic slot locking (kunci slot 10 menit anti-double-booking) & OTP rate limiting.
UPSTASH_REDIS_REST_URL="https://[YOUR-INSTANCE].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR-REST-TOKEN]"

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY: MIDTRANS SANDBOX
# ------------------------------------------------------------------------------
# Dapatkan di: Midtrans Sandbox Dashboard (https://dashboard.sandbox.midtrans.com)
# Buka Settings -> Access Keys untuk menyalin Server Key dan Client Key.
MIDTRANS_SERVER_KEY="SB-Mid-server-..."
MIDTRANS_CLIENT_KEY="Mid-client-..."
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="Mid-client-..."
MIDTRANS_IS_PRODUCTION="false"

# ------------------------------------------------------------------------------
# 4. APLIKASI & KEAMANAN ENKRIPSI
# ------------------------------------------------------------------------------
# Kunci rahasia untuk hash sesi cookie dan enkripsi PII (AES-256-GCM data kontak pemain).
# Buat string acak 32 karakter (misal: openssl rand -base64 32)
NEXTAUTH_SECRET="your-super-secret-random-key-at-least-32-chars-long"

# URL dasar aplikasi
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. EMAIL TRANSACTIONAL: RESEND
# ------------------------------------------------------------------------------
# Dapatkan di: Resend Dashboard (https://resend.com/api-keys)
# Digunakan untuk mengirimkan 6-digit OTP pendaftaran, lupa password, dan e-ticket booking.
RESEND_API_KEY="re_..."

# Email pengirim:
# - Dalam pengembangan (tanpa domain khusus): gunakan "Rally Padel Club <onboarding@resend.dev>"
# - Dalam produksi (dengan domain terverifikasi): gunakan "Rally Padel Club <no-reply@domainanda.com>"
EMAIL_FROM="Rally Padel Club <onboarding@resend.dev>"
