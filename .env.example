# ==========================================
# PADEL ARENA ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# 1. DATABASE (Supabase PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres"

# 2. UPSTASH REDIS (Atomic Real-time Slot Locking)
UPSTASH_REDIS_REST_URL="https://[YOUR-UPSTASH-INSTANCE].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR-UPSTASH-TOKEN]"

# 3. MIDTRANS PAYMENT GATEWAY (SANDBOX)
MIDTRANS_SERVER_KEY="SB-Mid-server-..."
MIDTRANS_CLIENT_KEY="Mid-client-..."
MIDTRANS_IS_PRODUCTION="false"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="Mid-client-..."

# 4. APP & AUTH
NEXTAUTH_SECRET="[GENERATE-A-SECURE-SECRET]"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 5. RESEND EMAIL SERVICE
RESEND_API_KEY="re_..."
EMAIL_FROM="Rally Padel Club <onboarding@resend.dev>"
